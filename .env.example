NODE_ENV=production
STICKER_ADMIN_EMAIL=admin@example.com
STICKER_ADMIN_PASSWORD=replace-with-a-long-random-password
STICKER_DB_PATH=./data/sticker.sqlite
STICKER_WEB_ORIGIN=https://sticker.example.com
STICKER_SECURE_COOKIE=1
